rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /rides/{rideId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.driverId == request.auth.uid;
      allow update: if request.auth != null
        && (
          resource.data.driverId == request.auth.uid
          || (
            request.resource.data.driverId == resource.data.driverId
            && request.resource.data.availableSeats >= 0
            && request.resource.data.availableSeats <= resource.data.seats
            && (
              (
                request.resource.data.availableSeats < resource.data.availableSeats
                && getAfter(/databases/$(database)/documents/bookings/$(rideId + '_' + request.auth.uid)).data.passengerId == request.auth.uid
                && getAfter(/databases/$(database)/documents/bookings/$(rideId + '_' + request.auth.uid)).data.status == 'pending'
              )
              || (
                request.resource.data.availableSeats > resource.data.availableSeats
                && exists(/databases/$(database)/documents/bookings/$(rideId + '_' + request.auth.uid))
                && get(/databases/$(database)/documents/bookings/$(rideId + '_' + request.auth.uid)).data.passengerId == request.auth.uid
                && get(/databases/$(database)/documents/bookings/$(rideId + '_' + request.auth.uid)).data.status in ['pending', 'accepted']
              )
            )
          )
        );
      allow delete: if request.auth != null
        && resource.data.driverId == request.auth.uid;
    }

    match /bookings/{bookingId} {
      allow create: if request.auth != null
        && request.resource.data.passengerId == request.auth.uid;
      allow get: if request.auth != null
        && (
          !exists(/databases/$(database)/documents/bookings/$(bookingId))
          ||
          resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
        );
      allow list: if request.auth != null
        && (
          resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
        );
      allow update, delete: if request.auth != null
        && (
          resource.data.passengerId == request.auth.uid
          || resource.data.driverId == request.auth.uid
        );
    }

    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
